<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_TaskMetadata"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="task-metadata-example" name="Example: Task Metadata" isExecutable="true"
                camunda:historyTimeToLive="1">
    <bpmn:startEvent id="StartEvent" name="Start">
      <bpmn:outgoing>Flow_Start_Metadata</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="MetadataTask" name="Read task metadata"
                      camunda:type="external" camunda:topic="Task Metadata">
      <bpmn:incoming>Flow_Start_Metadata</bpmn:incoming>
      <bpmn:outgoing>Flow_Metadata_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent" name="End">
      <bpmn:incoming>Flow_Metadata_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Metadata" sourceRef="StartEvent" targetRef="MetadataTask" />
    <bpmn:sequenceFlow id="Flow_Metadata_End" sourceRef="MetadataTask" targetRef="EndEvent" />
  </bpmn:process>
</bpmn:definitions>
