ENGINE_REST_BASE_URL=http://localhost:8080/engine-rest

# Pick exactly one authentication method: operaton-tasks rejects configs
# that set both ENGINE_REST_AUTHORIZATION and the OAuth2 client settings.
# Do not quote these values: devenv's dotenv loader keeps quote characters
# as part of the value instead of stripping them like a shell would.

# Basic auth
# ENGINE_REST_AUTHORIZATION=Basic ZGVtbzpkZW1v

# OAuth2 client credentials, matching the engine's OAuth2 protection below
OAUTH2_TOKEN_URL=http://localhost:8081/realms/operaton/protocol/openid-connect/token
OAUTH2_CLIENT_ID=operaton
OAUTH2_CLIENT_SECRET=UPgl7SnnJpXf2b6oScHZAt68SfIJZtRc

# Enables OAuth2 protection on the engine itself (see devenv.nix)
OPERATON_OAUTH2_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8081/realms/operaton
